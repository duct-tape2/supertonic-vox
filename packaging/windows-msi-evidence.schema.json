{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supertonicvox.example.invalid/schema/windows-msi-evidence-v2.json",
  "title": "SupertonicVox Windows MSI evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseEligible",
    "sourceCommit",
    "packageVersion",
    "identityMode",
    "upgradeCode",
    "productCode",
    "packageCode",
    "contractSha256",
    "signingPolicySha256",
    "preSignInventorySha256",
    "finalInventorySha256",
    "payloadManifestSha256",
    "unsignedMsiSha256",
    "iceValidatedUnsignedMsiSha256",
    "signedMsiSha256",
    "msiSigner",
    "timestamp",
    "toolchain",
    "signingDecisions",
    "iceValidation",
    "privacyEvidence",
    "externalApprovals",
    "nativeChecks",
    "openGates"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseEligible": { "type": "boolean" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "identityMode": { "enum": ["staging-placeholder", "owner-approved"] },
    "upgradeCode": { "$ref": "#/$defs/guid" },
    "productCode": { "$ref": "#/$defs/guid" },
    "packageCode": { "$ref": "#/$defs/guid" },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "signingPolicySha256": { "$ref": "#/$defs/sha256" },
    "preSignInventorySha256": { "$ref": "#/$defs/sha256" },
    "finalInventorySha256": { "$ref": "#/$defs/sha256" },
    "payloadManifestSha256": { "$ref": "#/$defs/sha256" },
    "unsignedMsiSha256": { "$ref": "#/$defs/sha256" },
    "iceValidatedUnsignedMsiSha256": { "$ref": "#/$defs/sha256" },
    "signedMsiSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "msiSigner": { "type": ["object", "null"] },
    "timestamp": { "type": ["object", "null"] },
    "toolchain": { "type": "object" },
    "signingDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "type",
          "preSignSha256",
          "finalSha256",
          "finalSizeBytes",
          "changedByApprovedOwnerSigning"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": {
            "enum": [
              "owner-sign",
              "verify-existing-authenticode",
              "approved-unsigned-pe",
              "hash-only-non-pe"
            ]
          },
          "type": { "enum": ["pe", "non-pe"] },
          "preSignSha256": { "$ref": "#/$defs/sha256" },
          "finalSha256": { "$ref": "#/$defs/sha256" },
          "finalSizeBytes": { "type": "integer", "minimum": 0 },
          "changedByApprovedOwnerSigning": { "type": "boolean" }
        }
      }
    },
    "iceValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unsignedMsiSha256", "suppressions"],
      "properties": {
        "status": { "const": "passed" },
        "unsignedMsiSha256": { "$ref": "#/$defs/sha256" },
        "suppressions": { "type": "array", "maxItems": 0 }
      }
    },
    "privacyEvidence": { "type": "array", "minItems": 1 },
    "externalApprovals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLicense", "modelRedistribution", "productionCatalogVerification"],
      "properties": {
        "sourceLicense": { "type": ["object", "null"] },
        "modelRedistribution": { "type": ["object", "null"] },
        "productionCatalogVerification": { "type": ["object", "null"] }
      }
    },
    "nativeChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstRelease",
        "cleanInstall",
        "offlineSynthesis",
        "saveRestart",
        "uninstall",
        "noOrphanProcesses",
        "upgrade",
        "downgradePrevention",
        "priorSignedMsiSha256"
      ],
      "properties": {
        "firstRelease": { "type": "boolean" },
        "cleanInstall": { "enum": ["passed", "missing"] },
        "offlineSynthesis": { "enum": ["passed", "missing"] },
        "saveRestart": { "enum": ["passed", "missing"] },
        "uninstall": { "enum": ["passed", "missing"] },
        "noOrphanProcesses": { "enum": ["passed", "missing"] },
        "upgrade": { "enum": ["passed", "not-applicable-first-release", "missing"] },
        "downgradePrevention": { "enum": ["passed", "not-applicable-first-release", "missing"] },
        "priorSignedMsiSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "openGates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "guid": { "type": "string", "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
